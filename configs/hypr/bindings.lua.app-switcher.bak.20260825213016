-- ── Smart Clipboard (macOS Style) ──────────────────────────────
-- Uses Hyprland's send_key_state API (same as omarchy defaults)
-- to properly handle terminal vs non-terminal windows.
local terminal_classes = {
  alacritty = true,
  ["com.mitchellh.ghostty"] = true,
  foot = true,
  kitty = true,
  wezterm = true,
}

local function active_window_is_terminal()
  local window = hl.get_active_window()
  if not window or not window.class then
    return false
  end
  return terminal_classes[window.class:lower()] == true
end

local function send_key(mod, key)
  hl.dispatch(hl.dsp.send_key_state({ mods = mod, key = key, state = "down" }))
  hl.timer(function()
    hl.dispatch(hl.dsp.send_key_state({ mods = mod, key = key, state = "up" }))
  end, { timeout = 50, type = "oneshot" })
end

local function smart_copy()
  if active_window_is_terminal() then
    send_key("CTRL+SHIFT", "C")
  else
    send_key("CTRL", "C")
  end
end

local function smart_paste()
  if active_window_is_terminal() then
    send_key("CTRL+SHIFT", "V")
  else
    send_key("CTRL", "V")
  end
end

local function smart_cut()
  send_key("CTRL", "X")
end

hl.unbind("SUPER + C")
hl.unbind("SUPER + V")
hl.unbind("SUPER + X")
o.bind("SUPER + C", "Copy", smart_copy)
o.bind("SUPER + V", "Paste", smart_paste)
o.bind("SUPER + X", "Cut", smart_cut)

