{
  "aliveStatusCodes": [
    200,
    206,
    301,
    302,
    307,
    308,
    403,
    429
  ],
  "fallbackRetryDelay": "30s",
  "httpHeaders": [
    {
      "headers": {
        "Accept-Encoding": "zstd, br, gzip, deflate"
      },
      "urls": [
        "https://github.com"
      ]
    }
  ],
  "ignorePatterns": [
    {
      "pattern": "^#"
    },
    {
      "pattern": "localhost"
    },
    {
      "pattern": "../../wiki/"
    },
    {
      "pattern": "stargazers"
    },
    {
      "pattern": "wiki/"
    }
  ],
  "replacementPatterns": [
    {
      "pattern": "^/",
      "replacement": "{{BASEURL}}/"
    }
  ],
  "retryCount": 3,
  "retryOn429": true,
  "timeout": "20s"
}
